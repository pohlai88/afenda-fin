{
  "name": "@afenda/db",
  "version": "0.0.0",
  "private": true,
  "description": "AFENDA persistence boundary: node-postgres pool/transaction capability, exact type parsing, checksummed forward-only migrations, and Testcontainers integration lane. No ledger/business schema in this package yet.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck:native": "tsc --noEmit -p tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node ./scripts/run-integration.ts",
    "generate:types": "node ./scripts/generate-types.ts",
    "check:types-drift": "node ./scripts/check-types-drift.ts"
  },
  "dependencies": {
    "@afenda/errors": "workspace:*",
    "pg": "8.22.0",
    "kysely": "0.29.4"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10",
    "testcontainers": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@electric-sql/pglite": "0.5.4",
    "kysely-codegen": "0.20.0"
  }
}
