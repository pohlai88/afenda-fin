{
  "name": "afenda-fin",
  "version": "0.0.0",
  "private": true,
  "description": "AFENDA authority layer and governance control plane. See README.md.",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build:authority-registry": "node scripts/build-authority-registry.ts",
    "gate:authority": "node scripts/check-authority-integrity.ts",
    "gate:authority:self-test": "node scripts/check-authority-integrity.ts --self-test",
    "verify:toolchain": "node scripts/verify-toolchain-baseline.ts",
    "typecheck:native": "tsc --noEmit -p tsconfig.json",
    "typecheck:native:single": "tsc --noEmit -p tsconfig.json --singleThreaded",
    "typecheck:compat": "tsc6 --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:dev": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "boundary:check": "depcruise packages --config .dependency-cruiser.cjs",
    "agent-docs": "node scripts/generate-agent-docs.ts",
    "db:up": "docker compose up -d postgres18 postgres17",
    "db:down": "docker compose down",
    "gate": "node scripts/gate.ts",
    "gate:db-integration": "node scripts/gate-db-integration.ts",
    "red": "node scripts/red.ts"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "turbo": "2.10.8",
    "eslint": "10.8.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.66.0",
    "dependency-cruiser": "18.1.1",
    "@types/node": "24.9.2",
    "globals": "17.9.0",
    "@afenda/errors": "workspace:*",
    "@afenda/time": "workspace:*",
    "@afenda/money": "workspace:*",
    "@afenda/contracts": "workspace:*",
    "@afenda/db": "workspace:*"
  }
}
